    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSwag.MSBuild" Version="14.7.1" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="xunit" Version="2.9.3" />
