<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>InvoiceReviewAssistant.Api</AssemblyName>
    <RootNamespace>InvoiceReviewAssistant.Api</RootNamespace>
    <UserSecretsId>0bed6cba-898f-4de2-838c-9dea6abbcaf2</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InvoiceReviewAssistant.Core\InvoiceReviewAssistant.Core.csproj" />
    <ProjectReference Include="..\InvoiceReviewAssistant.Infrastructure\InvoiceReviewAssistant.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="NSwag.MSBuild" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <InvoiceReviewClientDirectory>$(MSBuildProjectDirectory)\..\invoice-review-client</InvoiceReviewClientDirectory>
    <InvoiceReviewClientDistDirectory>$(InvoiceReviewClientDirectory)\dist</InvoiceReviewClientDistDirectory>
  </PropertyGroup>

  <Target Name="BuildInvoiceReviewClient" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(InvoiceReviewClientDirectory)" />
    <Exec Command="npm run build" WorkingDirectory="$(InvoiceReviewClientDirectory)" />
  </Target>

  <Target Name="CopyInvoiceReviewClientToPublish" AfterTargets="Publish" DependsOnTargets="BuildInvoiceReviewClient">
    <RemoveDir Directories="$(PublishDir)wwwroot" />
    <ItemGroup>
      <_InvoiceReviewClientFiles Include="$(InvoiceReviewClientDistDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_InvoiceReviewClientFiles)"
          DestinationFiles="@(_InvoiceReviewClientFiles->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
